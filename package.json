{
	"name": "fitway",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm -r dev",
		"build": "pnpm -r build",
		"check-types": "pnpm -r check-types",
		"dev:web": "pnpm --filter web dev",
		"dev:server": "pnpm --filter server dev",
		"db:push": "pnpm --filter @fitway/db db:push",
		"db:studio": "pnpm --filter @fitway/db db:studio",
		"db:generate": "pnpm --filter @fitway/db db:generate",
		"db:migrate": "pnpm --filter @fitway/db db:migrate",
		"edge:provision-dev": "pnpm --filter @fitway/db edge:provision-dev",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:browser": "playwright test",
		"test:simulator": "py -m unittest discover -s edge -p test_*.py"
	},
	"dependencies": {
		"@fitway/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@fitway/config": "workspace:*",
		"@playwright/test": "^1.61.1",
		"@types/node": "catalog:",
		"happy-dom": "^20.10.6",
		"lefthook": "^2.1.9",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vercel": "^54.18.6",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.9.0"
}
