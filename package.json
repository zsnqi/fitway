{
	"name": "fitway",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm -r dev",
		"build": "pnpm -r build",
		"check-types": "pnpm -r check-types",
		"dev:web": "pnpm --filter web dev",
		"dev:server": "pnpm --filter server dev",
		"db:push": "pnpm --filter @fitway/db db:push",
		"db:studio": "pnpm --filter @fitway/db db:studio",
		"db:generate": "pnpm --filter @fitway/db db:generate",
		"db:migrate": "pnpm --filter @fitway/db db:migrate",
		"deploy:setup": "vercel link",
		"dev:vercel": "vercel dev -L",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production",
		"deploy": "vercel deploy",
		"deploy:prod": "vercel deploy --prod",
		"deploy:check": "vercel deploy --dry",
		"check": "biome check --write ."
	},
	"dependencies": {
		"@fitway/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@fitway/config": "workspace:*",
		"@types/node": "catalog:",
		"lefthook": "^2.1.9",
		"tsx": "catalog:",
		"typescript": "catalog:",
		"vercel": "^54.18.6"
	},
	"packageManager": "pnpm@11.9.0"
}
