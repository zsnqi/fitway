{
  "name": "eclipse-launch-film",
  "private": true,
  "description": "Eclipse launch film, Station 2 (silent motion): cinetic's HyperFrames starter, 1920x1080 at 60 fps, 128 BPM.",
  "scripts": {
    "postinstall": "node setup.mjs",
    "textures": "node tools/textures.mjs",
