{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://fitway.local/schemas/history-transition-receipt.schema.json",
	"title": "FITWAY history transition receipt",
	"type": "object",
	"additionalProperties": false,
	"required": ["schemaVersion", "kind", "recordedAt"],
	"properties": {
		"schemaVersion": { "enum": [1, 2] },
		"kind": {
			"enum": ["history-genesis-receipt", "history-transition-receipt"]
		},
		"recordedAt": { "type": "string", "format": "date-time" },
		"historyPath": { "type": "string", "minLength": 1 },
		"legacyCheckpoint": { "$ref": "#/$defs/legacyCheckpoint" },
		"activeMilestoneDigests": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/hash" }
		},
		"historySha256": { "$ref": "#/$defs/hash" },
		"milestoneCount": { "type": "integer", "minimum": 0 },
		"historyByteLength": { "type": "integer", "minimum": 0 },
		"recordDigestMap": {
			"type": "object",
			"additionalProperties": { "$ref": "#/$defs/hash" }
		},
		"previousReceiptSha256": {
			"type": ["string", "null"],
			"pattern": "^[0-9a-f]{64}$"
		},
		"beforeHistorySha256": { "$ref": "#/$defs/hash" },
		"afterHistorySha256": { "$ref": "#/$defs/hash" },
		"beforeHistoryBytes": { "type": "integer", "minimum": 0 },
		"afterHistoryBytes": { "type": "integer", "minimum": 0 },
		"beforeMilestoneCount": { "type": "integer", "minimum": 0 },
		"afterMilestoneCount": { "type": "integer", "minimum": 0 },
		"addedTerminal": { "$ref": "#/$defs/addedTerminal" },
		"closedPacketSha256": { "$ref": "#/$defs/hash" },
		"removedActiveMilestoneId": { "type": "string", "minLength": 1 },
		"removedActiveMilestoneDigest": { "$ref": "#/$defs/hash" },
		"coordinatorRun": { "type": "string", "minLength": 1 },
		"predecessorAnchor": { "type": "object" },
		"before": { "type": "object" },
		"after": { "type": "object" },
		"addedMilestoneIds": { "type": "array", "items": { "type": "string" } },
		"modifiedPreExistingIds": {
			"type": "array",
			"items": { "type": "string" }
		},
		"deletedPreExistingIds": {
			"type": "array",
			"items": { "type": "string" }
		},
		"openStatusArchived": { "type": "boolean" },
		"successorMilestoneId": { "type": "string", "minLength": 1 },
		"limitation": { "type": "string", "minLength": 1 }
	},
	"allOf": [
		{
			"if": {
				"properties": { "kind": { "const": "history-genesis-receipt" } },
				"required": ["kind"]
			},
			"then": {
				"type": "object",
				"required": ["historySha256", "milestoneCount", "recordDigestMap"],
				"properties": {
					"historySha256": { "$ref": "#/$defs/hash" },
					"milestoneCount": { "type": "integer" },
					"recordDigestMap": { "type": "object" }
				}
			}
		},
		{
			"if": {
				"properties": {
					"schemaVersion": { "const": 2 },
					"kind": { "const": "history-genesis-receipt" }
				},
				"required": ["schemaVersion", "kind"]
			},
			"then": {
				"type": "object",
				"required": [
					"historyPath",
					"historyByteLength",
					"legacyCheckpoint",
					"activeMilestoneDigests"
				],
				"properties": {
					"historyPath": { "const": "PROJECT_STATE_HISTORY.yaml" },
					"historyByteLength": { "type": "integer", "minimum": 0 },
					"legacyCheckpoint": { "$ref": "#/$defs/legacyCheckpoint" },
					"activeMilestoneDigests": {
						"type": "object",
						"additionalProperties": { "$ref": "#/$defs/hash" }
					}
				}
			}
		},
		{
			"if": {
				"properties": { "kind": { "const": "history-transition-receipt" } },
				"required": ["kind"]
			},
			"then": {
				"type": "object",
				"properties": {
					"previousReceiptSha256": { "type": ["string", "null"] },
					"beforeHistorySha256": { "$ref": "#/$defs/hash" },
					"afterHistorySha256": { "$ref": "#/$defs/hash" },
					"beforeHistoryBytes": { "type": "integer", "minimum": 0 },
					"afterHistoryBytes": { "type": "integer", "minimum": 0 },
					"beforeMilestoneCount": { "type": "integer", "minimum": 0 },
					"afterMilestoneCount": { "type": "integer", "minimum": 0 },
					"addedTerminal": { "$ref": "#/$defs/addedTerminal" },
					"closedPacketSha256": { "$ref": "#/$defs/hash" },
					"removedActiveMilestoneId": { "type": "string" },
					"removedActiveMilestoneDigest": { "$ref": "#/$defs/hash" },
					"coordinatorRun": { "type": "string" }
				}
			}
		},
		{
			"if": {
				"properties": {
					"schemaVersion": { "const": 2 },
					"kind": { "const": "history-transition-receipt" }
				},
				"required": ["schemaVersion", "kind"]
			},
			"then": {
				"required": [
					"previousReceiptSha256",
					"beforeHistorySha256",
					"afterHistorySha256",
					"beforeHistoryBytes",
					"afterHistoryBytes",
					"beforeMilestoneCount",
					"afterMilestoneCount",
					"addedTerminal",
					"closedPacketSha256",
					"removedActiveMilestoneId",
					"removedActiveMilestoneDigest",
					"coordinatorRun"
				],
				"properties": {
					"previousReceiptSha256": { "$ref": "#/$defs/hash" },
					"removedActiveMilestoneDigest": { "$ref": "#/$defs/hash" }
				}
			}
		}
	],
	"$defs": {
		"hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
		"legacyCheckpoint": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"receiptPath",
				"receiptSha256",
				"afterHistorySha256",
				"afterHistoryBytes"
			],
			"properties": {
				"receiptPath": { "type": "string", "minLength": 1 },
				"receiptSha256": { "$ref": "#/$defs/hash" },
				"afterHistorySha256": { "$ref": "#/$defs/hash" },
				"afterHistoryBytes": { "type": "integer", "minimum": 0 }
			}
		},
		"addedTerminal": {
			"type": "object",
			"additionalProperties": false,
			"required": ["milestoneId", "status", "digest"],
			"properties": {
				"milestoneId": { "type": "string", "minLength": 1 },
				"status": {
					"enum": ["DONE", "BLOCKED", "NEEDS_HUMAN", "FAILED_VALIDATION"]
				},
				"digest": { "$ref": "#/$defs/hash" }
			}
		}
	}
}
