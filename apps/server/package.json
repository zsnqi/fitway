{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "tsx watch src/index.ts",
		"start": "node dist/index.mjs"
	},
	"dependencies": {
		"@fitway/api": "workspace:*",
		"@fitway/auth": "workspace:*",
		"@fitway/db": "workspace:*",
		"@fitway/env": "workspace:*",
		"@hono/node-server": "^2.0.8",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"better-auth": "catalog:",
		"dotenv": "catalog:",
		"drizzle-orm": "^0.45.2",
		"hono": "catalog:",
		"pg": "^8.22.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@fitway/config": "workspace:*",
		"@types/node": "catalog:",
		"@types/pg": "^8.20.0",
		"tsdown": "^0.22.3",
		"tsx": "catalog:",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"supabase"
	]
}
